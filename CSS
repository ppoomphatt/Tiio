body {
  margin: 0;
  padding: 0;
  background-color: #000;
  overflow: hidden;
  font-family: 'Arial', sans-serif;
}

#flowerCanvas {
  display: block;
}

.instruction {
  position: absolute;
  top: 20px;
  width: 100%;
  text-align: center;
  color: #ff99cc;
  font-size: 1.2rem;
  pointer-events: none;
  text-shadow: 0 0 10px rgba(255,153,204,0.5);
}

#wishBtn {
  position: absolute;
  bottom: 40px;
  left: 50%;
  transform: translateX(-50%);
  padding: 15px 30px;
  background: linear-gradient(45deg, #ff4d8d, #ff99cc);
  color: white;
  border: none;
  border-radius: 30px;
  font-size: 18px;
  cursor: pointer;
  box-shadow: 0 5px 20px rgba(255, 77, 141, 0.5);
  transition: 0.3s;
}

#wishBtn:hover {
  transform: translateX(-50%) scale(1.1);
}

